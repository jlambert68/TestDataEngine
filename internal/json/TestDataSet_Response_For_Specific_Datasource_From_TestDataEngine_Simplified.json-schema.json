{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestDataSet response for a specific datasource",
  "type": "object",
  "required": [
    "SchemaVersion",
    "TestDataSourceName",
    "TestDataSourceUuid",
    "JsonSchemaName",
    "TestData"
  ],
  "properties": {
    "SchemaVersion": {
      "type": "string",
      "title": "Specific Schema version",
      "description": "Version of the specific response schema.",
      "enum": [
        "1.0"
      ]
    },
    "TestDataSourceName": {
      "type": "string"
    },
    "TestDataSourceUuid": {
      "type": "string",
      "format": "uuid"
    },
    "JsonSchemaName": {
      "type": "string"
    },
    "TestData": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
