                  "maxLength": 3,
                  "pattern": "^[A-Z]{3}$"
                },
                "ISIN": {
                  "type": "string",
                  "minLength": 12,
                  "maxLength": 12
                },
                "SecurityType": {
                  "type": "string"
                },
                "ProvisionalIncome": {
                  "type": "string"
                },
                "ContraCurrency": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 3,
                      "pattern": "^[A-Z]{3}$"
                    }
                  ]
                },
                "InterimCurrency": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 3,
                      "pattern": "^[A-Z]{3}$"
                    }
                  ]
                },
                "PrincipalOrIncome": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "Random": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "SecProgram": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string"
                    }
                  ]
                }
